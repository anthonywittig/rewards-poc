# Defaults for a fresh checkout -- `make up` uses this file when .env is absent.
# Copy to .env (or .env.beta, …) only when you need local overrides. Every port
# is listed explicitly so a second stack is just a second file with a different
# COMPOSE_PROJECT_NAME and a different set of ports.
#
#   make up                     # uses .env if present, else this file
#   cp .env.example .env        # optional local overrides
#
# For a second stack side by side:
#
#   cp .env.example .env.beta   # set COMPOSE_PROJECT_NAME=rewards-beta,
#   make up ENV=.env.beta       # and bump every *_PORT
#
# COMPOSE_PROJECT_NAME isolates containers, networks, and named volumes, so the
# two stacks share nothing.

COMPOSE_PROJECT_NAME=rewards-alpha

# --- Published ports (host side) ---------------------------------------------
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8080
POSTGRES_PORT=5432
ES_PORT=9200
API_PORT=8081
WEB_PORT=5173

# --- Application ---------------------------------------------------------------
TEMPORAL_NAMESPACE=rewards
# The task queue name ("rewards") is a compile-time constant shared by the
# worker, the API, and the Makefile's CLI targets -- internal/rewards/state.go,
# not a knob here.

# 1h is Temporal's hard minimum for a namespace retention, verified against
# server 1.29.7 by `make verify-config`. The plan wanted 20m to make audit-log
# truncation quick to observe; that is not reachable on a released server (see
# deploy/dynamicconfig/dev.yaml). Use `make reap` to force truncation on demand
# instead of waiting an hour. See docs/FINDINGS.md#retention-has-a-one-hour-floor.
TEMPORAL_RETENTION=1h

# Rewards policy -- points cap, per-transaction maximum, and how many adds a run
# handles before continuing as new -- lives in internal/rewards/state.go as
# compile-time constants, not here. All three are baked into recorded workflow
# history, so changing one breaks running executions; that is a code change with
# a versioning story, not a deployment knob. See
# docs/FINDINGS.md#continue-as-new and #versioning-is-the-real-risk.

# --- Image versions ------------------------------------------------------------
# The auto-setup image ships the `temporal` CLI, so no separate admin-tools
# image is needed -- operational scripts exec into the server container.
TEMPORAL_VERSION=1.29.7
TEMPORAL_UI_VERSION=2.53.0
POSTGRES_VERSION=16-alpine
ELASTICSEARCH_VERSION=7.17.27

# --- Elasticsearch tuning ------------------------------------------------------
# See docs/FINDINGS.md#making-elasticsearch-cheap. 256m is the practical heap
# floor; the container
# limit is roughly 3x heap because of JVM overhead and Lucene off-heap use.
ES_JAVA_OPTS=-Xms256m -Xmx256m
ES_MEM_LIMIT=768m

# Visibility index refresh interval, applied by bootstrap.sh. Temporal's index
# template does not set this, so it would otherwise inherit Elasticsearch's 1s
# default. See docs/FINDINGS.md#visibility-lag.
ES_REFRESH_INTERVAL=200ms

# --- Postgres ------------------------------------------------------------------
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
